# SDKWork Skills local development
SDKWORK_SKILLS_APP_ROOT=.
SDKWORK_SKILLS_TENANT_ID=100001
SDKWORK_SKILLS_APP_BIND=127.0.0.1:18090
SDKWORK_SKILLS_BACKEND_BIND=127.0.0.1:18091
SDKWORK_SKILLS_WEB_FRAMEWORK=1

# Canonical workspace PostgreSQL development profile
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_AUTO_MIGRATE=true

# Frontend (apps/sdkwork-skills-pc) — use empty base URLs with Vite proxy in dev
VITE_SDKWORK_SKILLS_APP_API_BASE_URL=
VITE_SDKWORK_SKILLS_BACKEND_API_BASE_URL=
VITE_SDKWORK_SKILLS_DEFAULT_LOCALE=zh-CN

# Platform API gateway for IAM + appbase app SDK (local appbase gateway)
VITE_SDKWORK_SKILLS_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900

# Optional sdkwork-drive upload target for admin package uploads
# VITE_SDKWORK_SKILLS_DRIVE_SPACE_ID=
# VITE_SDKWORK_SKILLS_DRIVE_PARENT_NODE_ID=
# VITE_SDKWORK_DRIVE_APP_API_BASE_URL=
