{
  "$schema": "../sdkwork-github-workflow/schemas/sdkwork-workflow.schema.json",
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-skills",
    "name": "SDKWork Skills",
    "repository": "sdkwork-ai/sdkwork-skills",
    "sourcePath": ".",
    "configPath": "sdkwork.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-skills",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "app-manifest",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "sdkwork-ai/sdkwork-drive",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "sdkwork-ai/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-kernel",
      "repository": "sdkwork-ai/sdkwork-kernel",
      "refInput": "SDKWORK_KERNEL_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-generator",
      "repository": "sdkwork-ai/sdkwork-sdk-generator",
      "refInput": "SDKWORK_SDK_GENERATOR_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-search",
      "repository": "sdkwork-ai/sdkwork-search",
      "refInput": "SDKWORK_SEARCH_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "stable"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install workspace dependencies",
        "shell": "pwsh",
        "run": "pnpm install --no-frozen-lockfile --config.auto-install-peers=false"
      }
    ],
    "build": [
      {
        "name": "Run skills verification",
        "shell": "pwsh",
        "run": "pnpm verify"
      }
    ],
    "package": [
      {
        "name": "Build Skills API server binaries",
        "shell": "pwsh",
        "run": "cargo build --release -p sdkwork-api-skills-standalone-gateway"
      },
      {
        "name": "Build Skills PC web bundle",
        "shell": "pwsh",
        "run": "pnpm build"
      }
    ],
    "validate": [
      {
        "name": "Validate Skills contracts",
        "shell": "pwsh",
        "run": "pnpm verify"
      }
    ],
    "sign": [
      {
        "name": "Sign Skills release artifacts",
        "shell": "pwsh",
        "run": "node ../sdkwork-github-workflow/scripts/sign-release-artifacts.mjs --app sdkwork-skills --package-id $env:SDKWORK_PACKAGE_ID"
      }
    ],
    "sbom": [
      {
        "name": "Generate Skills SBOM",
        "shell": "pwsh",
        "run": "node ../sdkwork-github-workflow/scripts/generate-release-sbom.mjs --app sdkwork-skills --package-id $env:SDKWORK_PACKAGE_ID"
      }
    ]
  },
  "targets": [
    {
      "id": "linux-x64-standalone-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "tar.gz"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "target/release/sdkwork-api-skills-standalone-gateway*"
      ],
      "deploymentProfile": "standalone",
      "runtimeTarget": "server"
    },
    {
      "id": "web-universal-cloud-browser-zip",
      "profile": "browser",
      "platform": "web",
      "architecture": "universal",
      "formats": [
        "zip"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "apps/sdkwork-skills-pc/dist/**"
      ],
      "deploymentProfile": "cloud",
      "runtimeTarget": "browser"
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": true
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": false,
    "retentionDays": 30
  }
}
