# standalone.production
# Replace .invalid origins before exposing this profile to browser clients.
SDKWORK_SKILLS_DEPLOYMENT_PROFILE=standalone
SDKWORK_SKILLS_ENVIRONMENT=production
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://skills.standalone.production.invalid
SDKWORK_SKILLS_RUNTIME_TARGET=server
SDKWORK_SKILLS_PROFILE_ID=standalone.production
SDKWORK_SKILLS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8080
SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=https://skills.standalone.production.invalid

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SKILLS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

VITE_SDKWORK_SKILLS_ENVIRONMENT=production
VITE_SDKWORK_SKILLS_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_SKILLS_RUNTIME_TARGET=browser
VITE_SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=https://skills.standalone.production.invalid
VITE_SDKWORK_SKILLS_APP_API_BASE_URL=https://skills.standalone.production.invalid/app/v3/api
VITE_SDKWORK_SKILLS_BACKEND_API_BASE_URL=https://skills.standalone.production.invalid/backend/v3/api
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=https://api.sdkwork.com/app/v3/api

