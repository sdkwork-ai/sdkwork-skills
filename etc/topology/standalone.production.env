# standalone.production
# Replace .invalid origins before exposing this profile to browser clients.
SDKWORK_SKILLS_DEPLOYMENT_PROFILE=standalone
SDKWORK_SKILLS_ENVIRONMENT=production
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://skills.standalone.production.invalid,https://skills.sdkwork.com,https://skills.birdcoder.com,https://skills.dtupay.com,https://skills.noaper.com,https://skills.sdkwork.cn,https://skills.birdcoder.cn,https://skills.dtupay.cn,https://skills.noaper.cn,https://skills.skubc.com,https://skills.skubc.cn,https://skills.zowalk.com,https://skills.zowalk.cn,https://skills.offer86.com,https://skills.offer86.cn,https://skills.86offer.com,https://skills.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_SKILLS_RUNTIME_TARGET=server
SDKWORK_SKILLS_PROFILE_ID=standalone.production
SDKWORK_SKILLS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8080
SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=https://skills.standalone.production.invalid

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
