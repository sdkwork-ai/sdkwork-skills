# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_skills_demo`
# and a dedicated Redis logical DB index so no shared-redis cache key collides with another environment.
SDKWORK_SKILLS_DEPLOYMENT_PROFILE=cloud
SDKWORK_SKILLS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SKILLS_RUNTIME_TARGET=browser
SDKWORK_SKILLS_PROFILE_ID=cloud.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SKILLS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=https://skills-demo.sdkwork.com
SDKWORK_SKILLS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

VITE_SDKWORK_SKILLS_ENVIRONMENT=demo
VITE_SDKWORK_SKILLS_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_SKILLS_RUNTIME_TARGET=browser
VITE_SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=https://skills-demo.sdkwork.com
VITE_SDKWORK_SKILLS_APP_API_BASE_URL=https://skills-demo.sdkwork.com/app/v3/api
VITE_SDKWORK_SKILLS_BACKEND_API_BASE_URL=https://skills-demo.sdkwork.com/backend/v3/api
VITE_SDKWORK_SKILLS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=https://skills-demo.sdkwork.com/app/v3/api
