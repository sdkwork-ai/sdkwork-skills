# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_skills_demo`
# and a dedicated Redis logical DB index (`SDKWORK_SKILLS_REDIS_URL` `redis://127.0.0.1:6379/9`) so
# no shared-redis cache key (rate-limit, session, idempotency) ever collides with another environment.
SDKWORK_SKILLS_DEPLOYMENT_PROFILE=standalone
SDKWORK_SKILLS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SKILLS_RUNTIME_TARGET=server
SDKWORK_SKILLS_PROFILE_ID=standalone.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SKILLS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_SKILLS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18080
SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=http://skills-demo.sdkwork.com:18080

VITE_SDKWORK_SKILLS_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL=http://skills-demo.sdkwork.com:18080
VITE_SDKWORK_SKILLS_APP_API_BASE_URL=http://skills-demo.sdkwork.com:18080/app/v3/api
VITE_SDKWORK_SKILLS_BACKEND_API_BASE_URL=http://skills-demo.sdkwork.com:18080/backend/v3/api
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://skills-demo.sdkwork.com:18080/app/v3/api
SDKWORK_CORS_ALLOWED_ORIGINS=https://skills-demo.sdkwork.com,http://skills-demo.sdkwork.com,https://skills-demo.birdcoder.com,http://skills-demo.birdcoder.com,https://skills-demo.dtupay.com,http://skills-demo.dtupay.com,https://skills-demo.noaper.com,http://skills-demo.noaper.com,https://skills-demo.sdkwork.cn,http://skills-demo.sdkwork.cn,https://skills-demo.birdcoder.cn,http://skills-demo.birdcoder.cn,https://skills-demo.dtupay.cn,http://skills-demo.dtupay.cn,https://skills-demo.noaper.cn,http://skills-demo.noaper.cn,https://skills-demo.skubc.com,http://skills-demo.skubc.com,https://skills-demo.skubc.cn,http://skills-demo.skubc.cn,https://skills-demo.zowalk.com,http://skills-demo.zowalk.com,https://skills-demo.zowalk.cn,http://skills-demo.zowalk.cn,https://skills-demo.offer86.com,http://skills-demo.offer86.com,https://skills-demo.offer86.cn,http://skills-demo.offer86.cn,https://skills-demo.86offer.com,http://skills-demo.86offer.com,https://skills-demo.86offer.cn,http://skills-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
